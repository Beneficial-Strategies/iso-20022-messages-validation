{
 "rule": "AccountOwnerRule",
 "text": "AccountOwner must be present or Transaction(*)/AccountOwner must be present, but not both.",
 "reading": "AccountOwner is present, or Transaction has AccountOwner in every item, and not both",
 "rules": [
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/Transaction"
     ],
     [
      "Presence",
      "/Transaction[*]/AccountOwner"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/AccountOwner"
     ]
    ]
   }
  },
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/Transaction[*]/AccountOwner"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/AccountOwner"
     ]
    ]
   }
  }
 ]
}
