{
 "rule": "CashAccountOwnerRule",
 "text": "CashAccountOwner must be present or Movement(*)/AccountOwner must be present, but not both.",
 "reading": "CashAccountOwner is present, or Movement has AccountOwner in every item, and not both",
 "rules": [
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/Movement"
     ],
     [
      "Presence",
      "/Movement[*]/AccountOwner"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/CashAccountOwner"
     ]
    ]
   }
  },
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/Movement[*]/AccountOwner"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/CashAccountOwner"
     ]
    ]
   }
  }
 ]
}
