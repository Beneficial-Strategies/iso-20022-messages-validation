{
 "rule": "StatusAndReasonRule",
 "text": "StatusAndReason must be present or Movement(*)/StatusAndReason must be present, but not both.",
 "reading": "StatusAndReason is present, or Movement has StatusAndReason in every item, and not both",
 "rules": [
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/Movement"
     ],
     [
      "Presence",
      "/Movement[*]/StatusAndReason"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/StatusAndReason"
     ]
    ]
   }
  },
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/Movement[*]/StatusAndReason"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/StatusAndReason"
     ]
    ]
   }
  }
 ]
}
