{
 "rule": "SafekeepingAccountRule",
 "text": "SafekeepingAccount must be present or Cancellation(*)/SafekeepingAccount must be present, but not both.",
 "reading": "SafekeepingAccount is present, or Cancellation has SafekeepingAccount in every item, and not both",
 "rules": [
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/Cancellation"
     ],
     [
      "Presence",
      "/Cancellation[*]/SafekeepingAccount"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/SafekeepingAccount"
     ]
    ]
   }
  },
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/Cancellation[*]/SafekeepingAccount"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/SafekeepingAccount"
     ]
    ]
   }
  }
 ]
}
