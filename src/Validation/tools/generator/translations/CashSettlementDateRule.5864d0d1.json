{
 "rule": "CashSettlementDateRule",
 "text": "Either CashSettlementDate is present or all occurrences of IndividualExecutionDetails/CashSettlementDate are present, but not both.",
 "reading": "CashSettlementDate is present, or there are items and all have one, and not both",
 "rules": [
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/IndividualExecutionDetails"
     ],
     [
      "Presence",
      "/IndividualExecutionDetails[*]/CashSettlementDate"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/CashSettlementDate"
     ]
    ]
   }
  },
  {
   "must": {
    "connector": "AND",
    "rules": [
     [
      "Absence",
      "/IndividualExecutionDetails[*]/CashSettlementDate"
     ]
    ]
   },
   "when": {
    "connector": "AND",
    "rules": [
     [
      "Presence",
      "/CashSettlementDate"
     ]
    ]
   }
  }
 ]
}
