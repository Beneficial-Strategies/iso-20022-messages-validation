<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The two newest .NET LTS releases, plus netstandard2.0 as the entry point for older systems (.NET Framework 4.6.1+, Mono, Unity). -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022.Messages.Validation</RootNamespace>
    <AssemblyName>BeneficialStrategies.Iso20022.Messages.Validation</AssemblyName>
    <!--
      Enabled 2026-08-31: the validator CLASSES already carry rich <summary>/<remarks> content
      (which spec constraints each one enforces — see CLAUDE.md's "Adding a New Validator"
      section) that was previously compiled into nothing, since no .xml doc file was ever
      generated. Consumers got zero IntelliSense benefit from that content despite it already
      existing in source. Turning this on surfaced two real, now-closed backlogs: 988 validator
      constructors with no doc comment at all (CS1591 — mechanically fixed via a templated
      <summary> insertion, since every one was a bare parameterless constructor with nothing
      unique to say) and 171 XML doc <see cref> references that didn't resolve (CS1574 — fixed by
      restoring a missing `Choices.` namespace prefix on Choice-variant references, and adding the
      correct namespace to cross-references between validator classes). Both are ordinary,
      always-on warnings now — deliberately NOT suppressed going forward, so a future validator
      added without a doc comment (or with a broken cref) fails the build immediately instead of
      the gap silently regrowing.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageFiles>$(MSBuildThisFileDirectory)..\..\artifacts\package\</PackageFiles>
    <PackageId>BeneficialStrategies.Iso20022.Messages.Validation</PackageId>
    <PackageDescription>FluentValidation validators for the interfaces of the ISO 20022 messages, components and choices: the rules the type system alone cannot express, such as cross-field rules and the check of a code against a registry. Written for the interfaces, so they validate whatever implements them: the records, objects of the Factory, or a class of your own.</PackageDescription>
    <!-- The README and the release notes of a release are made by tools/package/prepare_package_files.py; without them (a local pack) the README of the repository is used. -->
    <PackageReleaseNotes Condition="Exists('$(PackageFiles)release-notes.txt')">$([System.IO.File]::ReadAllText("$(PackageFiles)release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PackageFiles)README.md" Pack="true" PackagePath="\" Condition="Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="!Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\.beneficial\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.*" />
    <!--
      Powers AddIso20022Validators() (Extensions/ServiceCollectionExtensions.cs) — a thin wrapper
      around FluentValidation's own AddValidatorsFromAssemblyContaining<T>(). Pulls in
      Microsoft.Extensions.DependencyInjection.Abstractions transitively, which is standard and
      expected for a validators package designed for DI registration.
    -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- From the lowest version that works to just below the next breaking change. -->
    <PackageReference Include="BeneficialStrategies.Iso20022.Primitives" Version="[1.0.1-alpha, 1.1.0)" />
    <PackageReference Include="BeneficialStrategies.Iso20022.Messages" Version="[1.0.1-alpha, 1.1.0)" />
  </ItemGroup>

</Project>
